msgid "Zum Wartungsbuch"
msgstr "Till underhållsboken"

#, python-format
msgid "Hallo %(name)s,"
msgstr "Hej %(name)s,"

msgid "mit diesem Link kommst du ins Wartungsbuch:"
msgstr "med den här länken kommer du till underhållsboken:"

#, python-format
msgid "Der Link gilt %(stunden)s Stunde(n) und lässt sich nur einmal benutzen."
msgstr "Länken gäller i %(stunden)s timme/timmar och kan bara användas en gång."

msgid "Wenn du dich nicht anmelden wolltest, kannst du diese Nachricht übergehen."
msgstr "Om du inte ville logga in kan du bortse från det här meddelandet."

msgid "Anmeldung beim Wartungsbuch"
msgstr "Logga in till underhållsboken"

#, python-format
msgid "das steht an – fällig oder in den nächsten %(tage)s Tagen fällig werdend:"
msgstr "det här är aktuellt – nu eller inom de närmaste %(tage)s dagarna:"

msgid "Saisonstart – das hat sich über die Ruhezeit angesammelt:"
msgstr "Säsongsstart – det här har samlats under vilotiden:"

#, python-format
msgid "seit %(tage)s Tagen"
msgstr "sedan %(tage)s dagar"

msgid "Erledigt:"
msgstr "Utförd:"

msgid "Die Links gelten einmalig und laufen nach zehn Tagen ab."
msgstr "Länkarna fungerar en gång och upphör efter tio dagar."

#, python-format
msgid "Wartungsbuch: 1 Aufgabe"
