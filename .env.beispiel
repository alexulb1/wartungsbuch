# Werte für den Portainer-Stack. In Portainer unter "Environment variables"
# eintragen — nicht in das Git-Repository legen (SPEC 8).

# --- Pflicht ---------------------------------------------------------------
# Zufallswert erzeugen:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

DJANGO_ALLOWED_HOSTS=wartung.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://wartung.example.org
# Basis für Links in Mails — bewusst fest, nicht aus dem Host-Kopf der Anfrage.
DJANGO_BASIS_URL=https://wartung.example.org

# --- Abbild und Anschluss --------------------------------------------------
ABBILD=ghcr.io/alexulb1/wartungsbuch:latest
PORT=8071
# Auf dem NAS besser ein Pfad, den die Datensicherung mitnimmt:
# SICHERUNGSPFAD=/volume1/docker/wartungsbuch/sicherungen
SICHERUNGSPFAD=sicherungen
# Anhänge. Auf dem NAS ein echter Pfad, damit Hyper Backup sie mitnimmt —
# der JSON-Abzug enthält die Dateien NICHT, nur die Verweise darauf.
# MEDIENPFAD=/volume1/docker/wartungsbuch/medien
MEDIENPFAD=medien

# --- Datenbank -------------------------------------------------------------
# Das Passwort darf beliebige Sonderzeichen enthalten — es wird als Einzelwert
# durchgereicht, nicht in eine URL eingebaut.
POSTGRES_DB=wartungsbuch
POSTGRES_USER=wartung

# --- Mailversand -----------------------------------------------------------
EMAIL_HOST=smtp.mailbox.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# --- Dashboard -------------------------------------------------------------
# Wie weit "Was ansteht" vorausschaut. Überfälliges bleibt immer sichtbar,
# Späteres ist über "Alles anzeigen" erreichbar.
DASHBOARD_HORIZONT_TAGE=30

# --- Wochenmail ------------------------------------------------------------
# 0 = Montag … 6 = Sonntag
WOCHENMAIL_WOCHENTAG=0
WOCHENMAIL_STUNDE=7

DJANGO_TIME_ZONE=Europe/Berlin
